# =============================================================================
#  CONFIGURACION DE ENTORNO - POS Carniceria (plantilla)
# =============================================================================
# Copia este archivo a `.env` y completa los valores reales. `.env` esta en
# `.gitignore` — nunca debe versionarse con secretos reales.
#
# Todas las variables las carga y VALIDA `src/config/env.ts` (Zod, fail-fast:
# el proceso no arranca si falta o es invalida alguna variable requerida).
# Ese archivo es la unica fuente de verdad sobre que variables existen y que
# formato exigen — esta plantilla puede quedar desactualizada si `env.ts`
# cambia despues; ante cualquier duda, revisar `env.ts` directamente.
#
# Hallazgo de seguridad #9 (auditoria 31/07/2026): este archivo no existia
# en el repo pese a estar documentado como la plantilla oficial en
# `docs/ARCHITECTURE.md`/`README.md`.

# ----- Aplicacion -----
NODE_ENV=development
PORT=3000
API_PREFIX=/api/v1

# UUID de la sucursal de esta instalacion (una unica sucursal por instalacion
# on-premise, ver docs/ARCHITECTURE.md). Debe existir ya como fila en
# `sucursales` (creada por el seed) antes de arrancar.
SUCURSAL_ID=00000000-0000-0000-0000-000000000000

# ----- Base de datos -----
# connection_limit/pool_timeout/connect_timeout son parametros de conexion
# de Prisma anexados a la URL como query string (ver comentario en
# src/config/database.ts) — ajustar segun max_connections de PostgreSQL y
# el hardware real del servidor.
DATABASE_URL=postgresql://usuario:contrasena@localhost:5432/carniceria_pos?connection_limit=20

# Usados por los scripts de respaldo/restauracion (scripts/*.sh, pg_dump/psql),
# NO por env.ts directamente — deben coincidir con los datos de DATABASE_URL.
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=carniceria_pos
POSTGRES_USER=usuario
POSTGRES_PASSWORD=contrasena

# ----- Autenticacion -----
# Hallazgo de seguridad #8: minimo 32 caracteres ALEATORIOS (no una frase
# memorable). Generar con: openssl rand -base64 48
# JWT_SECRET y JWT_REFRESH_SECRET deben ser DISTINTOS entre si.
JWT_SECRET=reemplaza_con_openssl_rand_base64_48
JWT_EXPIRES_IN=15m
JWT_REFRESH_SECRET=reemplaza_con_otro_openssl_rand_base64_48_distinto
JWT_REFRESH_EXPIRES_IN=7d

# ----- Seguridad -----
BCRYPT_SALT_ROUNDS=12
# Contrasena del usuario administrador que crea el seed inicial (minimo 8
# caracteres) — cambiarla despues del primer login.
SEED_ADMIN_PASSWORD=cambia-esta-contrasena-despues-del-primer-login

# ----- CORS -----
# Origen(es) exactos del frontend, separados por coma si son varios
# (ej. "https://pos.mi-carniceria.local,https://pos-backup.mi-carniceria.local").
#
# Hallazgo de seguridad #1 (CRITICO): "*" SOLO es valido en development/test
# — env.ts rechaza el arranque si NODE_ENV=production y CORS_ORIGIN incluye
# "*". Combinado con `credentials: true` (obligatorio para la cookie
# httpOnly del refresh token), un origen reflejado sin restriccion en
# produccion permite que cualquier sitio robe la sesion via /auth/refresh.
CORS_ORIGIN=http://localhost:5173

# ----- Rate limiting -----
# Cada categoria de trafico (`config/rateLimitPolicies.ts`) tiene su propio
# contador independiente Y su propio par window/max, calibrado a su volumen
# real (investigacion 429 recurrente, 03/08/2026) — ya no comparten el mismo
# limite entre si. `auth` (login/refresh/logout, bajo volumen) es la unica
# que sigue usando las 2 variables genericas de abajo.
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=300

# Cotizacion de venta (POST /sales/quote): se llama varias veces por cada
# venta finalizada (cada edicion del carrito) — ventana corta, cupo alto.
RATE_LIMIT_QUOTE_WINDOW_MS=60000
RATE_LIMIT_QUOTE_MAX=120

# Operaciones transaccionales reales (venta/anulacion/correccion, compras,
# caja, devoluciones, ajustes de inventario, Alegra) — ya no comparte cupo
# con la cotizacion de arriba. Recalibrado x3 (Version 1.0.3, Bloque 7):
# tambien absorbe las consultas de Facturacion Electronica hechas antes de
# anular una venta — ver el comentario real en src/config/env.ts.
RATE_LIMIT_TRANSACTIONAL_WINDOW_MS=300000
RATE_LIMIT_TRANSACTIONAL_MAX=450

# Lecturas de alto volumen (reportes, notificaciones, listados GET).
RATE_LIMIT_REPORTS_WINDOW_MS=300000
RATE_LIMIT_REPORTS_MAX=900

# Endpoints administrativos de bajo volumen (usuarios, roles, permisos,
# catalogos de configuracion, auditoria).
RATE_LIMIT_ADMINISTRATIVE_WINDOW_MS=900000
RATE_LIMIT_ADMINISTRATIVE_MAX=200

# Intentos de POST /auth/login permitidos por ventana (mitigacion de fuerza
# bruta) — en development se eleva automaticamente a 1000 (ver
# src/middlewares/rateLimit.middleware.ts), este valor solo aplica en
# produccion/test.
LOGIN_RATE_LIMIT_WINDOW_MS=900000
LOGIN_RATE_LIMIT_MAX=5

# ----- Logging -----
LOG_LEVEL=info

# ----- Respaldos -----
BACKUP_CRON=0 2 * * *
BACKUP_DIR=./backups
BACKUP_RETENTION_DAYS=30
BACKUP_ENABLED=true
# Opcional: carpeta con pg_dump/pg_restore reales. En desarrollo local,
# sin definir, se asume que ya estan en el PATH del sistema.
# POSTGRES_BIN_DIR=

# ----- Imagenes de producto -----
PRODUCT_IMAGES_STORAGE_DIR=./storage/product-images
# Host publico usado para construir la URL absoluta de Product.imageUrl —
# en produccion, la URL real donde el backend es accesible.
PRODUCT_IMAGES_BASE_URL=http://localhost:3000
PRODUCT_IMAGE_MAX_SIZE_MB=5

# ----- Proxy inverso (hallazgo de seguridad #10) -----
# "false" (default): SIN cambios respecto al comportamiento actual — este
# despliegue on-premise no usa proxy inverso, express-rate-limit/req.ip usan
# la conexion directa del cliente.
#
# Configurar SOLO si en el futuro se agrega un proxy/balanceador delante del
# backend (ej. para acceso remoto): un numero de saltos confiables (ej. "1")
# o la lista de IPs/CIDR de esos proxies (ej. "127.0.0.1,10.0.0.5"). Nunca
# "true" sin restriccion — env.ts rechaza ese valor explicitamente, ya que
# con un proxy real por delante permitiria falsificar X-Forwarded-For y
# burlar el Rate Limiting.
TRUST_PROXY=false

# ----- Integraciones (Bloque 7.4) -----
# Clave simetrica del servidor (32 bytes hex = 64 caracteres) usada para
# cifrar en reposo credenciales de terceros reversibles (hoy: el token de
# Alegra, ver modules/integrations/alegra). Genera una propia con:
#   openssl rand -hex 32
# Si se pierde o se rota sin migrar los datos ya cifrados, esas credenciales
# quedan irrecuperables y deben volver a configurarse.
INTEGRATIONS_ENCRYPTION_KEY=
