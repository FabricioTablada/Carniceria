@baseUrl = http://localhost:3000/api/v1

###############################################################################
# CARNICERIA POS BACKEND
# QA - Hallazgo 3.2 de auditoria: PATCH /cash/sessions/:id/close ya no
# acepta `closedByUserId` del body -- siempre usa el usuario autenticado
# (req.user.id, resuelto desde el JWT por authenticate.middleware.ts).
#
# A diferencia del hallazgo 2.2 (InventoryMovement, sin endpoint de
# lectura), este caso SI se puede verificar completamente por API:
# `CashSessionResponse.closedByUserId` es un campo publico de la
# respuesta (`cash/types.ts`), asi que se puede confirmar exactamente
# quien quedo registrado como responsable del cierre, tanto en la
# respuesta del PATCH como en un GET posterior independiente. La unica
# distincion que este archivo NO puede probar es si el backend "ignora"
# el campo del body sin siquiera leerlo, o si lo lee y lo descarta --
# mismo comportamiento observable en ambos casos, sin diferencia de
# seguridad relevante.
#
# Completamente autocontenido: crea sus propias cajas registradoras y
# sesiones. No depende del estado dejado por ningun otro archivo QA, y
# puede correrse repetidas veces sin fallar (recursos con sufijo de
# tiempo via {{$timestamp}}).
#
# Cobertura:
#   1. Login
#   2. Preparacion de datos (caja registradora + sesion de prueba #1)
#   3. Cerrar sesion #1 SIN closedByUserId en el body -> debe funcionar
#      y quedar atribuida al usuario autenticado
#   4. Preparacion de datos (caja registradora + sesion de prueba #2)
#   5. Cerrar sesion #2 enviando un closedByUserId DISTINTO (inexistente)
#      en el body -> el backend debe ignorarlo y usar igual el usuario
#      autenticado, sin devolver error
#   6. Confirmar via GET que ambas sesiones quedaron cerradas
#      correctamente y atribuidas al usuario real
###############################################################################

###############################################################################
# 1. LOGIN
###############################################################################

### Login (admin)
# @name login

POST {{baseUrl}}/auth/login
Content-Type: application/json

{
  "username": "admin",
  "password": "Admin123!"
}

###############################################################################
# 2. PREPARACION: caja registradora y sesion de prueba #1
###############################################################################

### Caja registradora #1, dedicada a este QA
# @name createCashRegister1

POST {{baseUrl}}/cash-registers
Authorization: Bearer {{login.response.body.data.accessToken}}
Content-Type: application/json

{
  "sucursalId": "00000000-0000-0000-0000-000000000001",
  "name": "Caja QA close-session-security 1 {{$timestamp}}",
  "active": true
}

###

### Abrir sesion #1
# @name openSession1

POST {{baseUrl}}/cash/sessions
Authorization: Bearer {{login.response.body.data.accessToken}}
Content-Type: application/json

{
  "cashRegisterId": "{{createCashRegister1.response.body.data.id}}",
  "openingAmount": 10000,
  "notes": "QA close-session-security - sesion 1"
}

###############################################################################
# 3. CERRAR sesion #1 SIN closedByUserId en el body
###############################################################################

### Cerrar sin enviar closedByUserId -> debe funcionar y atribuirse al admin
# @name closeSession1NoField

PATCH {{baseUrl}}/cash/sessions/{{openSession1.response.body.data.id}}/close
Authorization: Bearer {{login.response.body.data.accessToken}}
Content-Type: application/json

{
  "closingAmount": 10000,
  "notes": "QA close-session-security - cierre sin closedByUserId"
}

# Verificar:
# - HTTP 200 (no 400: closedByUserId ya no es obligatorio)
# - body.data.status === "CLOSED"
# - body.data.closedByUserId === "{{login.response.body.data.user.id}}" (el admin autenticado)
# - body.data.closedBy.id === "{{login.response.body.data.user.id}}"

###

### Confirmar el estado persistido con un GET independiente
GET {{baseUrl}}/cash/sessions/{{openSession1.response.body.data.id}}
Authorization: Bearer {{login.response.body.data.accessToken}}

# Verificar:
# - HTTP 200
# - body.data.status === "CLOSED"
# - body.data.closedByUserId === "{{login.response.body.data.user.id}}"

###############################################################################
# 4. PREPARACION: caja registradora y sesion de prueba #2
###############################################################################

### Caja registradora #2, dedicada a este QA (separada de la #1 para que
### cada caso sea independiente, sin reutilizar una sesion ya cerrada)
# @name createCashRegister2

POST {{baseUrl}}/cash-registers
Authorization: Bearer {{login.response.body.data.accessToken}}
Content-Type: application/json

{
  "sucursalId": "00000000-0000-0000-0000-000000000001",
  "name": "Caja QA close-session-security 2 {{$timestamp}}",
  "active": true
}

###

### Abrir sesion #2
# @name openSession2

POST {{baseUrl}}/cash/sessions
Authorization: Bearer {{login.response.body.data.accessToken}}
Content-Type: application/json

{
  "cashRegisterId": "{{createCashRegister2.response.body.data.id}}",
  "openingAmount": 5000,
  "notes": "QA close-session-security - sesion 2"
}

###############################################################################
# 5. CERRAR sesion #2 enviando un closedByUserId DISTINTO (inexistente)
###############################################################################

### closedByUserId apunta a un usuario que no existe -- si el backend
### todavia lo leyera del body, esto fallaria con 404 "Usuario" (el
### comportamiento anterior a este hallazgo). Con el fix, el campo se
### ignora por completo y el cierre se atribuye al admin autenticado sin
### ningun error.
# @name closeSession2FakeField

PATCH {{baseUrl}}/cash/sessions/{{openSession2.response.body.data.id}}/close
Authorization: Bearer {{login.response.body.data.accessToken}}
Content-Type: application/json

{
  "closedByUserId": "11111111-1111-1111-1111-111111111111",
  "closingAmount": 5000,
  "notes": "QA close-session-security - cierre con closedByUserId falso"
}

# Verificar:
# - HTTP 200 (NO 404 "Usuario" -- si esto fallara, seria una regresion
#   del hallazgo 3.2: significaria que el backend volvio a leer
#   closedByUserId del body)
# - body.data.status === "CLOSED"
# - body.data.closedByUserId === "{{login.response.body.data.user.id}}" (el admin real, NO "11111111-...")
# - body.data.closedBy.id === "{{login.response.body.data.user.id}}"

###############################################################################
# 6. CONFIRMACION FINAL: ambas sesiones cerradas y atribuidas correctamente
###############################################################################

### GET independiente de la sesion #2 -- confirma que lo persistido
### coincide con la respuesta del PATCH, no solo lo que devolvio en el momento
GET {{baseUrl}}/cash/sessions/{{openSession2.response.body.data.id}}
Authorization: Bearer {{login.response.body.data.accessToken}}

# Verificar:
# - HTTP 200
# - body.data.status === "CLOSED"
# - body.data.closedByUserId === "{{login.response.body.data.user.id}}"
# - body.data.closedByUserId !== "11111111-1111-1111-1111-111111111111"